/div><div class="grid two"><div class="card"><h3>Operación</h3><div class="list"><div class="row"><b>Moneda</b><span>EUR (€)</span></div><div class="row"><b>Impuestos</b><span>Configurables</span></div><div class="row"><b>Numeración pedidos</b><span>Automática</span></div><div class="row"><b>Separar Cocina / Bar</b><span>Activado</span></div></div></div><div class="card"><h3>Integraciones futuras</h3><div class="list"><div class="row"><b>Impresoras</b><span class="badge">Pendiente</span></div><div class="row"><b>Instagram / Facebook</b><span class="badge">Pendiente API</span></div><div class="row"><b>Base de datos</b><span class="badge">Supabase · RestOS+</span></div><div class="row"><b>Usuarios y login</b><span class="badge">Supabase Auth · aprobación por rol</span></div></div></div></div></section>
</div></main></div><div id="noteModal" class="modal"><div class="modal-card"><div class="section-title"><h3>Nota / modificadores</h3><button class="btn" onclick="closeNote()">×</button></div><p style="color:var(--muted)">Ej.: sin cebolla, término medio, extra queso.</p><textarea id="noteText"></textarea><button class="btn primary" style="width:100%;margin-top:12px" onclick="saveNote()">Guardar nota</button></div></div><script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2.116.0"></script><script>
const SUPABASE_URL='https://qynvduumazthcxkxipkc.supabase.co';
const SUPABASE_PUBLISHABLE_KEY='sb_publishable_hFz1hmivDmmDPUhZ8tNpgw_U6GbMFKK';
const sb=window.supabase.createClient(SUPABASE_URL,SUPABASE_PUBLISHABLE_KEY,{auth:{persistSession:true,autoRefreshToken:true,detectSessionInUrl:true}});
let pendingRegistration=null,verifyExpiry=0,verifyInterval=null,recovery={email:'',expiry:0},recoveryInterval=null,authFlow=null,currentPermissions=new Set(),isDesignMode=false,currentUserContext=null;
function showAuth(id){authShell.classList.remove('hidden');document.querySelectorAll('.auth-view').forEach(v=>v.classList.remove('active'));document.getElementById(id).classList.add('active');document.querySelectorAll('.auth-error').forEach(e=>e.textContent='')}
function setBusy(btn,busy,label){if(!btn)return;btn.disabled=busy;if(busy){btn.dataset.label=btn.textContent;btn.textContent=label||'Procesando…'}else if(btn.dataset.label){btn.textContent=btn.dataset.label;delete btn.dataset.label}}
function validEmail(v){return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(v)}
function friendlyAuthError(err){let m=(err?.message||'').toLowerCase();if(m.includes('invalid login credentials'))return'Correo o contraseña incorrectos.';if(m.includes('email not confirmed'))return'Primero debes verificar tu correo electrónico.';if(m.includes('user already registered'))return'Ya existe una cuenta con ese correo.';if(m.includes('password should be'))return'La contraseña no cumple los requisitos de seguridad.';if(m.includes('rate limit'))return'Demasiados intentos. Espera un momento y vuelve a intentarlo.';if(m.includes('database error'))return'No fue posible crear el perfil. Revisa si el nombre de usuario ya está en uso.';return err?.message||'Ocurrió un error. Inténtalo nuevamente.'}
function showPending(title,message,icon='⏳'){pendingTitle.textContent=title;pendingMessage.innerHTML=message;pendingIcon.textContent=icon;showAuth('pendingView')}
function enterDesignMode(){sessionStorage.setItem('restos-design-session','1');isDesignMode=true;currentPermissions=new Set(menu.map(m=>m[3]));currentUserContext={name:'Usuario de desarrollo',role:'Owner / Super Admin',restaurant:'Modo diseño'};enterApp(currentUserContext,true)}
async function login(){let email=loginEmail.value.trim().toLowerCase(),password=loginPass.value;if(!validEmail(email)){loginError.textContent='Introduce un correo válido.';return}if(!password){loginError.textContent='Escribe tu contraseña.';return}setBusy(loginBtn,true,'Ingresando…');authFlow='login';try{let{data,error}=await sb.auth.signInWithPassword({email,password});if(error)throw error;await handleAuthenticatedUser(data.user)}catch(e){loginError.textContent=friendlyAuthError(e);await sb.auth.signOut().catch(()=>{})}finally{authFlow=null;setBusy(loginBtn,false)}}
async function handleAuthenticatedUser(user){if(!user)return;let{data:profile,error:pErr}=await sb.from('profiles').select('id,full_name,email,username,access_status').eq('id',user.id).single();if(pErr){await sb.auth.signOut();showPending('No pudimos cargar tu perfil','La identidad fue autenticada, pero RestOS+ no pudo leer tu perfil. Contacta al administrador.','!');return}let status=profile.access_status||'pending';if(status!=='active'){await sb.auth.signOut();let map={pending:['Cuenta pendiente de aprobación','Tu correo está verificado, pero <b>todavía no tienes acceso</b>. Un administrador debe aprobar tu cuenta y asignarte un rol.','⏳'],suspended:['Cuenta suspendida','Tu cuenta está suspendida. Contacta al administrador del restaurante.','⛔'],rejected:['Solicitud no aprobada','La solicitud de acceso no fue aprobada. Contacta al administrador si necesitas revisión.','×']};let x=map[status]||['Acceso no disponible','Tu cuenta no está habilitada para entrar en RestOS+.','!'];showPending(...x);return}let{data:membership,error:mErr}=await sb.from('memberships').select('id,restaurant_id,role_id,status,all_locations').eq('user_id',user.id).eq('status','active').order('created_at',{ascending:true}).limit(1).maybeSingle();if(mErr||!membership){await sb.auth.signOut();showPending('Falta asignar restaurante y rol','Tu cuenta está aprobada, pero todavía no tiene una <b>membresía activa</b> con restaurante y rol.','⏳');return}let[{data:role},{data:restaurant},{data:permRows}]=await Promise.all([sb.from('roles').select('id,name').eq('id',membership.role_id).single(),sb.from('restaurants').select('id,name').eq('id',membership.restaurant_id).single(),sb.from('role_permissions').select('permission_code').eq('role_id',membership.role_id)]);currentPermissions=new Set((permRows||[]).map(x=>x.permission_code));currentUserContext={id:user.id,name:profile.full_name||profile.username||user.email,role:role?.name||'Rol',restaurant:restaurant?.name||'Restaurante',membership};isDesignMode=false;sessionStorage.removeItem('restos-design-session');enterApp(currentUserContext,false)}
function enterApp(ctx,design=false){authShell.classList.add('hidden');profileName.textContent=ctx?.name||'Usuario';profileRole.textContent=design?'Owner / Super Admin · modo diseño':`${ctx?.role||'Rol'} · ${ctx?.restaurant||'Restaurante'}`;renderNav();let first=visibleMenu()[0]?.[0]||'dashboard';go(first)}
async function logout(){sessionStorage.removeItem('restos-design-session');isDesignMode=false;currentPermissions=new Set();currentUserContext=null;try{await sb.auth.signOut()}catch(e){}loginPass.value='';showAuth('loginView')}
async function startRegistration(){let name=regName.value.trim(),email=regEmail.value.trim().toLowerCase(),phone=regPhone.value.trim(),username=regUser.value.trim(),password=regPass.value,password2=regPass2.value;if(!name||!email||!phone||!username||!password||!password2){regError.textContent='Completa todos los campos.';return}if(!validEmail(email)){regError.textContent='Introduce un correo válido.';return}if(username.length<3){regError.textContent='El nombre de usuario debe tener al menos 3 caracteres.';return}if(password.length<8){regError.textContent='La contraseña debe tener al menos 8 caracteres.';return}if(password!==password2){regError.textContent='Las contraseñas no coinciden.';return}setBusy(registerBtn,true,'Creando cuenta…');authFlow='signup';try{let{data,error}=await sb.auth.signUp({email,password,options:{data:{full_name:name,phone,username}}});if(error)throw error;pendingRegistration={email};verifyEmail.textContent=email;buildCodeBoxes();startVerifyTimer();showAuth('verifyView');if(data.session){await sb.auth.signOut();showPending('Cuenta creada','La cuenta fue creada. <b>Esto todavía no concede acceso.</b> Un administrador debe aprobarla y asignarle un rol.','✓')}}catch(e){regError.textContent=friendlyAuthError(e)}finally{authFlow=null;setBusy(registerBtn,false)}}
function buildCodeBoxes(){codeBoxes.innerHTML=Array.from({length:6},(_,i)=>`<input maxlength="1" inputmode="numeric" autocomplete="one-time-code" id="c${i}" oninput="codeInput(${i},this)">`).join('');setTimeout(()=>document.getElementById('c0')?.focus(),80)}
function codeInput(i,el){el.value=el.value.replace(/\D/g,'').slice(0,1);if(el.value&&i<5)document.getElementById('c'+(i+1)).focus()}
function startVerifyTimer(){clearInterval(verifyInterval);verifyExpiry=Date.now()+180000;verifyInterval=setInterval(()=>{let left=Math.max(0,verifyExpiry-Date.now()),s=Math.ceil(left/1000);verifyTimer.textContent=String(Math.floor(s/60)).padStart(2,'0')+':'+String(s%60).padStart(2,'0');if(!left)clearInterval(verifyInterval)},250)}
async function verifyCode(){if(!pendingRegistration?.email){showAuth('registerView');return}if(Date.now()>verifyExpiry){verifyError.textContent='El código venció. Solicita uno nuevo.';return}let code=Array.from({length:6},(_,i)=>document.getElementById('c'+i)?.value||'').join('');if(code.length!==6){verifyError.textContent='Escribe los 6 dígitos.';return}setBusy(verifyBtn,true,'Verificando…');authFlow='signup-verify';try{let{error}=await sb.auth.verifyOtp({email:pendingRegistration.email,token:code,type:'email'});if(error)throw error;await sb.auth.signOut();clearInterval(verifyInterval);pendingRegistration=null;showPending('Correo verificado','Tu identidad por correo quedó verificada. <b>La cuenta permanece pendiente</b> hasta que un administrador la apruebe y asigne un rol.','✓')}catch(e){verifyError.textContent=friendlyAuthError(e)}finally{authFlow=null;setBusy(verifyBtn,false)}}
async function resendCode(){if(!pendingRegistration?.email)return;verifyError.textContent='';try{let{error}=await sb.auth.resend({type:'signup',email:pendingRegistration.email});if(error)throw error;buildCodeBoxes();startVerifyTimer();demoCode.innerHTML='<b>Código reenviado.</b> Revisa tu correo y usa el nuevo PIN de 6 dígitos.'}catch(e){verifyError.textContent=friendlyAuthError(e)}}
async function startRecovery(){let email=forgotEmail.value.trim().toLowerCase();if(!validEmail(email)){forgotError.textContent='Introduce un correo válido.';return}setBusy(recoverySendBtn,true,'Enviando…');authFlow='recovery-request';try{let{error}=await sb.auth.resetPasswordForEmail(email);if(error)throw error;recovery={email,expiry:Date.now()+180000};recoveryEmailLabel.textContent=email;recoveryCode.value='';showAuth('recoveryCodeView');startRecoveryTimer()}catch(e){forgotError.textContent=friendlyAuthError(e)}finally{authFlow=null;setBusy(recoverySendBtn,false)}}
function startRecoveryTimer(){clearInterval(recoveryInterval);recovery.expiry=Date.now()+180000;recoveryInterval=setInterval(()=>{let left=Math.max(0,recovery.expiry-Date.now()),s=Math.ceil(left/1000);recoveryTimer.textContent=String(Math.floor(s/60)).padStart(2,'0')+':'+String(s%60).padStart(2,'0');if(!left)clearInterval(recoveryInterval)},250)}
async function checkRecoveryCode(){if(!recovery.email){showAuth('forgotView');return}if(Date.now()>recovery.expiry){recoveryError.textContent='El código venció. Solicita uno nuevo.';return}let token=recoveryCode.value.replace(/\D/g,'').slice(0,6);if(token.length!==6){recoveryError.textContent='Escribe los 6 dígitos.';return}setBusy(recoveryVerifyBtn,true,'Verificando…');authFlow='recovery-verify';try{let{error}=await sb.auth.verifyOtp({email:recovery.email,token,type:'recovery'});if(error)throw error;clearInterval(recoveryInterval);showAuth('newPasswordView')}catch(e){recoveryError.textContent=friendlyAuthError(e)}finally{authFlow=null;setBusy(recoveryVerifyBtn,false)}}
async function resendRecoveryCode(){if(!recovery.email)return;recoveryError.textContent='';try{let{error}=await sb.auth.resetPasswordForEmail(recovery.email);if(error)throw error;startRecoveryTimer();recoveryError.textContent='Código reenviado. Revisa tu correo.'}catch(e){recoveryError.textContent=friendlyAuthError(e)}}
async function finishRecovery(){if(newPass1.value.length<8){newPassError.textContent='La contraseña debe tener al menos 8 caracteres.';return}if(newPass1.value!==newPass2.value){newPassError.textContent='Las contraseñas no coinciden.';return}setBusy(newPasswordBtn,true,'Actualizando…');authFlow='recovery-update';try{let{error}=await sb.auth.updateUser({password:newPass1.value});if(error)throw error;await sb.auth.signOut();recovery={email:'',expiry:0};newPass1.value='';newPass2.value='';showPending('Contraseña actualizada','Tu contraseña se actualizó correctamente. Ya puedes volver al ingreso.','✓')}catch(e){newPassError.textContent=friendlyAuthError(e)}finally{authFlow=null;setBusy(newPasswordBtn,false)}}
async function loginWithGoogle(){if(location.protocol==='file:'){loginError.textContent='Google OAuth necesita abrir RestOS+ desde http://, https:// o un dominio publicado. Usa “Modo diseño” mientras trabajas con el archivo local.';return}localStorage.setItem('restos-oauth-pending','1');let redirectTo=location.origin+location.pathname;let{error}=await sb.auth.signInWithOAuth({provider:'google',options:{redirectTo}});if(error){localStorage.removeItem('restos-oauth-pending');loginError.textContent=friendlyAuthError(error)}}

const menu=[['dashboard','▦','Resumen','dashboard.view'],['tables','▣','Mesas','tables.view'],['order','🧾','Toma de pedido','orders.create'],['kitchen','🍳','Cocina','kitchen.view'],['cashier','💳','Cobrar','payments.create'],['orders','☷','Pedidos','orders.view'],['inventory','📦','Inventario','inventory.view'],['productsView','🍔','Productos','products.view'],['customers','👥','Clientes','customers.view'],['reservations','📅','Reservas','reservations.view'],['staff','🔐','Personal','staff.view'],['reports','📊','Reportes','reports.view'],['tv','📺','Pantalla TV','display.view'],['settings','⚙','Configuración','settings.view']];
sb.auth.onAuthStateChange((event,session)=>{if(e