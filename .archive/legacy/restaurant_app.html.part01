<!doctype html><html lang="es"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>RestOS+ · Restaurant System</title><style>
:root{--bg:#f4f6f8;--card:#fff;--ink:#18211b;--muted:#738078;--brand:#174c36;--accent:#e7a83e;--line:#e5e9e6;--danger:#b84b4b;--ok:#27835b;--warn:#d48b25;--shadow:0 14px 40px #18211b14}*{box-sizing:border-box}body{margin:0;font-family:Inter,ui-sans-serif,system-ui,-apple-system,Segoe UI,sans-serif;background:var(--bg);color:var(--ink)}button,input{font:inherit}button{cursor:pointer}.app{display:grid;grid-template-columns:270px 1fr;min-height:100vh}.side{background:#102f24;color:white;padding:24px 16px;display:flex;flex-direction:column;gap:20px}.brand{font-size:24px;font-weight:900;padding:6px 10px}.brand small{display:block;font-size:11px;letter-spacing:2px;color:#a9c1b7;margin-top:4px}.nav{display:grid;gap:5px}.nav button{border:0;background:transparent;color:#cfe0d9;text-align:left;padding:13px 14px;border-radius:13px;font-weight:700;font-size:15px}.nav button:hover,.nav button.active{background:#ffffff17;color:white}.nav .ico{font-size:19px;width:29px;display:inline-block}.profile{margin-top:auto;background:#ffffff12;border-radius:16px;padding:14px}.profile b{display:block}.profile span{font-size:12px;color:#bad0c7}.main{min-width:0}.top{height:76px;background:#ffffffcc;backdrop-filter:blur(10px);border-bottom:1px solid var(--line);display:flex;align-items:center;justify-content:space-between;padding:0 28px;position:sticky;top:0;z-index:5}.top h1{font-size:22px;margin:0}.actions{display:flex;gap:10px}.btn{border:0;border-radius:13px;padding:12px 16px;font-weight:800;background:white;box-shadow:0 0 0 1px var(--line)}.btn.primary{background:var(--brand);color:white;box-shadow:none}.content{padding:26px;max-width:1500px;margin:auto}.view{display:none}.view.active{display:block}.hero{display:flex;justify-content:space-between;gap:20px;align-items:end;margin-bottom:22px}.hero h2{margin:0;font-size:28px}.hero p{margin:5px 0 0;color:var(--muted)}.grid{display:grid;gap:16px}.stats{grid-template-columns:repeat(4,1fr)}.card{background:var(--card);border:1px solid var(--line);border-radius:20px;padding:20px;box-shadow:var(--shadow)}.stat .label{color:var(--muted);font-weight:700}.stat strong{font-size:31px;display:block;margin-top:8px}.stat small{color:var(--muted)}.two{grid-template-columns:1.45fr 1fr}.section-title{display:flex;align-items:center;justify-content:space-between;margin-bottom:14px}.section-title h3{margin:0}.tables{display:grid;grid-template-columns:repeat(4,1fr);gap:12px}.table{border:2px solid var(--line);background:white;border-radius:17px;padding:17px;min-height:116px;text-align:left}.table b{font-size:18px}.table span{display:block;margin-top:18px;font-size:12px;font-weight:800}.free span{color:var(--ok)}.occupied{border-color:#f0c57d;background:#fffaf0}.occupied span{color:var(--warn)}.ready{border-color:#8ac7a8;background:#f1fbf6}.ready span{color:var(--ok)}.pay{border-color:#d8a0a0;background:#fff5f5}.pay span{color:var(--danger)}.quick{display:grid;grid-template-columns:1fr 1fr;gap:12px}.quick button{min-height:88px;border:1px solid var(--line);background:#fff;border-radius:17px;font-size:16px;font-weight:850}.quick .bigico{font-size:27px;display:block;margin-bottom:7px}.list{display:grid;gap:10px}.row{display:flex;justify-content:space-between;align-items:center;padding:14px;border:1px solid var(--line);border-radius:14px}.row small{color:var(--muted);display:block;margin-top:3px}.badge{padding:6px 9px;border-radius:999px;font-size:11px;font-weight:900;background:#eef2ef}.products{display:grid;grid-template-columns:repeat(3,1fr);gap:12px}.product{border:1px solid var(--line);border-radius:16px;background:#fff;padding:16px;text-align:left;min-height:110px}.product strong{display:block;font-size:16px}.product em{display:block;margin-top:22px;font-style:normal;font-weight:900;color:var(--brand)}.order-layout{display:grid;grid-template-columns:1fr 370px;gap:16px}.order-cart{position:sticky;top:96px;height:max-content}.kds{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}.ticket{border-top:6px solid var(--accent)}.ticket h3{margin:0}.ticket .time{font-size:24px;font-weight:900;margin:12px 0}.ticket button{width:100%;margin-top:14px}.tv{background:#102f24;color:white;border-radius:24px;padding:38px;min-height:520px;display:grid;place-items:center;text-align:center}.tv h2{font-size:46px;margin:0}.socials{display:flex;gap:50px;margin-top:40px}.socials strong{font-size:42px;display:block}.socials span{color:#bcd0c8}.placeholder{min-height:330px;display:grid;place-items:center;text-align:center}.placeholder .icon{font-size:58px}.placeholder h3{font-size:24px;margin:12px 0 4px}.placeholder p{max-width:600px;color:var(--muted)}@media(max-width:1000px){.app{grid-template-columns:82px 1fr}.side{padding:20px 10px}.brand{font-size:0}.brand:before{content:'R';font-size:28px}.brand small,.nav .txt,.profile{display:none}.nav button{text-align:center;padding:13px 4px}.nav .ico{width:auto}.stats{grid-template-columns:1fr 1fr}.two,.order-layout{grid-template-columns:1fr}.tables{grid-template-columns:repeat(3,1fr)}.kds{grid-template-columns:1fr 1fr}}@media(max-width:650px){.app{display:block}.side{position:fixed;bottom:0;left:0;right:0;height:72px;z-index:20;display:block;padding:8px;background:#102f24}.brand,.profile{display:none}.nav{display:flex;overflow-x:auto}.nav button{min-width:72px}.nav button:nth-child(n+7){display:none}.main{padding-bottom:78px}.top{height:65px;padding:0 16px}.content{padding:17px}.stats{grid-template-columns:1fr 1fr}.stat strong{font-size:25px}.two{grid-template-columns:1fr}.tables{grid-template-columns:1fr 1fr}.products,.kds{grid-template-columns:1fr 1fr}.hero{align-items:start;flex-direction:column}.actions .btn:first-child{display:none}.socials{gap:20px;flex-direction:column}.tv h2{font-size:34px}}

.auth-shell{position:fixed;inset:0;z-index:100;background:linear-gradient(135deg,#0d2c21 0%,#174c36 48%,#f2f5f3 48%,#f2f5f3 100%);display:grid;place-items:center;padding:24px}.auth-shell.hidden{display:none}.auth-wrap{width:min(1080px,100%);display:grid;grid-template-columns:1fr 480px;background:#fff;border-radius:30px;overflow:hidden;box-shadow:0 30px 90px #071d1650;min-height:650px}.auth-brand{background:#102f24;color:#fff;padding:54px;display:flex;flex-direction:column;justify-content:space-between}.auth-brand .mark{font-size:32px;font-weight:950}.auth-brand h2{font-size:42px;line-height:1.05;margin:0 0 16px}.auth-brand p{color:#bdd0c8;font-size:17px;line-height:1.6}.auth-points{display:grid;gap:13px;color:#dce8e3}.auth-panel{padding:44px;display:flex;align-items:center}.auth-view{display:none;width:100%}.auth-view.active{display:block}.auth-view h1{font-size:31px;margin:0 0 8px}.auth-view>.sub{color:var(--muted);margin:0 0 28px;line-height:1.5}.field{margin-bottom:15px}.field label{display:block;font-size:13px;font-weight:850;margin-bottom:7px}.field input{width:100%;height:52px;border:1.5px solid #dce3df;border-radius:13px;padding:0 15px;outline:none;background:#fbfcfb}.field input:focus{border-color:var(--brand);box-shadow:0 0 0 4px #174c3612}.auth-btn{width:100%;min-height:54px;border:0;border-radius:14px;font-weight:900;font-size:16px;background:var(--brand);color:#fff}.auth-btn.secondary{background:#fff;color:var(--ink);border:1.5px solid var(--line);margin-top:11px}.auth-links{display:flex;justify-content:space-between;gap:12px;margin:16px 0 0}.linkbtn{border:0;background:none;color:var(--brand);font-weight:850;padding:4px 0}.divider{display:flex;align-items:center;gap:12px;color:#9aa59f;font-size:12px;margin:20px 0}.divider:before,.divider:after{content:'';height:1px;background:var(--line);flex:1}.google-btn{width:100%;height:52px;border:1.5px solid var(--line);border-radius:14px;background:#fff;font-weight:850;font-size:15px}.google-g{display:inline-grid;place-items:center;width:25px;height:25px;border-radius:50%;margin-right:8px;font-weight:950;color:#4285f4}.notice{padding:13px 14px;border-radius:13px;background:#f3f7f5;color:#456057;font-size:13px;line-height:1.45;margin:15px 0}.notice.warn{background:#fff8e9;color:#795b1e}.code-boxes{display:grid;grid-template-columns:repeat(6,1fr);gap:8px;margin:18px 0}.code-boxes input{text-align:center;font-size:23px;font-weight:900;height:55px;border:1.5px solid var(--line);border-radius:12px;width:100%}.timer{text-align:center;color:var(--muted);font-size:13px;margin:10px 0 17px}.auth-error{color:var(--danger);font-size:13px;font-weight:750;min-height:19px;margin:8px 0}.devbox{margin-top:14px;padding:12px;border:1px dashed #b9c8c1;border-radius:12px;background:#f8faf9;font-size:12px;color:#65756e}.logout{margin-top:10px;width:100%;border:0;background:#ffffff10;color:#d9e8e2;border-radius:11px;padding:9px;font-weight:800}.pending-card{text-align:center}.pending-icon{font-size:58px}.pending-card h1{margin-top:15px}.pending-card p{color:var(--muted);line-height:1.55}
@media(max-width:800px){.auth-shell{padding:12px;background:#f2f5f3}.auth-wrap{grid-template-columns:1fr;min-height:0;border-radius:22px}.auth-brand{display:none}.auth-panel{padding:28px 22px;min-height:620px}.auth-view h1{font-size:27px}}

.order-mode{display:flex;gap:10px;flex-wrap:wrap;margin-bottom:16px}.seg{border:1px solid var(--line);background:#fff;border-radius:14px;padding:12px 16px;font-weight:850}.seg.active{background:var(--brand);color:#fff}.order-tools{display:flex;gap:10px;flex-wrap:wrap;margin-bottom:16px}.order-tools select,.order-tools input{height:46px;border:1px solid var(--line);border-radius:12px;padding:0 12px;background:#fff}.sent-block{border:1px solid var(--line);border-radius:15px;padding:12px;margin-bottom:10px;background:#f8faf9}.sent-head{display:flex;justify-content:space-between;gap:10px;margin-bottom:8px;font-size:12px;color:var(--muted);font-weight:850}.draft-line{display:grid;grid-template-columns:1fr auto;gap:10px;align-items:center;border:1px solid var(--line);border-radius:14px;padding:11px;margin-bottom:8px}.qty{display:flex;align-items:center;gap:7px}.qty button{width:38px;height:38px;border:1px solid var(--line);background:#fff;border-radius:10px;font-size:20px;font-weight:900}.line-actions{display:flex;gap:6px;margin-top:7px}.mini{border:0;background:#eef2ef;border-radius:9px;padding:7px 9px;font-weight:800}.mini.danger{background:#fff0f0;color:var(--danger)}.order-summary{background:#f7faf8;border-radius:15px;padding:12px;margin-top:12px}.status-strip{display:flex;gap:7px;flex-wrap:wrap;margin:10px 0}.status-pill{font-size:11px;font-weight:900;padding:6px 9px;border-radius:999px;background:#eef2ef}.modal{position:fixed;inset:0;background:#071d1670;z-index:80;display:none;place-items:center;padding:20px}.modal.open{display:grid}.modal-card{width:min(520px,100%);background:#fff;border-radius:22px;padding:22px;box-shadow:0 25px 80px #0004}.modal-card textarea{width:100%;min-height:100px;border:1px solid var(--line);border-radius:12px;padding:12px}.station{font-size:11px;color:var(--muted);font-weight:800}.quickpay{background:#fff8e9;border:1px solid #efd49c;border-radius:15px;padding:12px;margin-bottom:14px}
</style></head><body>
<div class="auth-shell" id="authShell"><div class="auth-wrap">
  <div class="auth-brand"><div class="mark">RestOS+<small style="display:block;font-size:11px;letter-spacing:2px;color:#a9c1b7;margin-top:5px">RESTAURANT SYSTEM</small></div><div><h2>Todo el restaurante.<br>Una sola operación.</h2><p>Pedidos, mesas, cocina, caja e inventario conectados en una interfaz rápida y clara.</p><div class="auth-points"><span>✓ Operación en tiempo real</span><span>✓ Roles y permisos por usuario</span><span>✓ Diseñado para móvil, tablet y PC</span></div></div><small style="color:#8eaaa0">RestOS+ · Supabase Auth + prototipo POS</small></div>
  <div class="auth-panel">
    <div class="auth-view active" id="loginView"><h1>Bienvenido</h1><p class="sub">Ingresa con el correo verificado de tu cuenta RestOS+.</p><div class="field"><label>Correo electrónico</label><input id="loginEmail" type="email" autocomplete="email" placeholder="nombre@correo.com"></div><div class="field"><label>Contraseña</label><input id="loginPass" type="password" autocomplete="current-password" placeholder="••••••••"></div><div class="auth-error" id="loginError"></div><button class="auth-btn" id="loginBtn" onclick="login()">Ingresar</button><div class="auth-links"><button class="linkbtn" onclick="showAuth('forgotView')">¿Olvidaste tu contraseña?</button><button class="linkbtn" onclick="showAuth('registerView')">Crear cuenta</button></div><div class="divider">o continúa con</div><button class="google-btn" onclick="loginWithGoogle()"><span class="google-g">G</span>Continuar con Google</button><div class="devbox"><b>Desarrollo de interfaz:</b> la autenticación real ya está conectada a Supabase, pero puedes seguir recorriendo toda la aplicación sin credenciales.<button class="auth-btn secondary" style="margin-top:10px" onclick="enterDesignMode()">Entrar en modo diseño</button></div></div>
    <div class="auth-view" id="registerView"><h1>Crear cuenta</h1><p class="sub">Verificaremos tu correo, pero el acceso seguirá pendiente hasta que un administrador apruebe la cuenta y asigne un rol.</p><div class="field"><label>Nombre completo</label><input id="regName" autocomplete="name" placeholder="Nombre y apellidos"></div><div class="field"><label>Correo electrónico</label><input id="regEmail" type="email" autocomplete="email" placeholder="nombre@correo.com"></div><div class="field"><label>Número de celular</label><input id="regPhone" type="tel" autocomplete="tel" placeholder="+356 ..."></div><div class="field"><label>Nombre de usuario</label><input id="regUser" autocomplete="username" placeholder="Ej. michael.romero"></div><div class="field"><label>Contraseña</label><input id="regPass" type="password" auto