vent==='PASSWORD_RECOVERY'){setTimeout(()=>showAuth('newPasswordView'),0);return}if((event==='SIGNED_IN'||event==='INITIAL_SESSION')&&session?.user&&!authFlow&&!isDesignMode){setTimeout(()=>handleAuthenticatedUser(session.user),0)}});
const products=[{id:1,n:'Classic Burger',p:12.5,d:'kitchen',cat:'Comida'},{id:2,n:'Pizza Margherita',p:11,d:'kitchen',cat:'Comida'},{id:3,n:'Pasta Carbonara',p:13.5,d:'kitchen',cat:'Comida'},{id:4,n:'Caesar Salad',p:9.5,d:'kitchen',cat:'Comida'},{id:5,n:'Cerveza',p:4.5,d:'bar',cat:'Bebidas'},{id:6,n:'Copa de vino',p:6,d:'bar',cat:'Bebidas'},{id:7,n:'Agua mineral',p:2.5,d:'bar',cat:'Bebidas'},{id:8,n:'Tiramisú',p:6.5,d:'kitchen',cat:'Postres'},{id:9,n:'Espresso',p:2.2,d:'bar',cat:'Bebidas'}];
let state=JSON.parse(localStorage.getItem('restos-demo')||'null')||{tables:Array.from({length:12},(_,i)=>({id:i+1,status:'free'})),orders:[],sales:0,activity:['Sistema iniciado en modo desarrollo'],nextOrder:1001};
if(!state.nextOrder) state.nextOrder=Math.max(1001,...state.orders.map(o=>o.id+1));
state.orders.forEach(o=>{if(!o.rounds)o.rounds=[{id:1,created:o.created||Date.now(),status:o.status||'new',items:o.items||[]}];if(!o.mode)o.mode='table'});
let currentTable=null,currentOrderId=null,cart=[],orderMode='table',noteIndex=null;
const save=()=>{localStorage.setItem('restos-demo',JSON.stringify(state));renderAll();};
function visibleMenu(){return isDesignMode?menu:menu.filter(m=>currentPermissions.has(m[3]))}
function renderNav(){let vm=visibleMenu();nav.innerHTML=vm.map((m,i)=>`<button data-view="${m[0]}" class="${i?'':'active'}" onclick="go('${m[0]}',this)"><span class="ico">${m[1]}</span><span class="txt">${m[2]}</span></button>`).join('');if(topKitchenBtn)topKitchenBtn.style.display=(isDesignMode||currentPermissions.has('kitchen.view'))?'':'none';if(topNewOrderBtn)topNewOrderBtn.style.display=(isDesignMode||currentPermissions.has('orders.create'))?'':'none'}
function can(permission){return isDesignMode||currentPermissions.has(permission)}
function init(){productsEl();renderAll();renderNav();initAuth()}
async function initAuth(){if(sessionStorage.getItem('restos-design-session')){enterDesignMode();return}try{let{data,error}=await sb.auth.getUser();if(!error&&data?.user){await handleAuthenticatedUser(data.user);localStorage.removeItem('restos-oauth-pending');return}}catch(e){}showAuth('loginView')}
function go(id,el){let meta=menu.find(x=>x[0]===id);if(!meta)return;if(!isDesignMode&&!currentPermissions.has(meta[3])){alert('Tu rol no tiene permiso para abrir este módulo.');return}document.querySelectorAll('.view').forEach(x=>x.classList.remove('active'));document.getElementById(id).classList.add('active');document.querySelectorAll('.nav button').forEach(x=>x.classList.remove('active'));document.querySelector(`.nav button[data-view="${id}"]`)?.classList.add('active');pageTitle.textContent=meta[2]||'RestOS+';renderAll()}
function openOrderForTable(id){return state.orders.find(o=>o.mode==='table'&&o.table===id&&o.status!=='paid'&&o.status!=='closed')}
function tableHTML(t){let labels={free:'LIBRE',occupied:'CUENTA ABIERTA',ready:'PEDIDO LISTO',pay:'POR COBRAR'};return `<button class="table ${t.status}" onclick="openTable(${t.id})"><b>Mesa ${String(t.id).padStart(2,'0')}</b><span>${labels[t.status]||t.status}</span></button>`}
function orderTotal(o){return (o.rounds||[]).flatMap(r=>r.items||[]).filter(i=>!i.voided).reduce((s,i)=>s+i.p*i.q,0)}
function renderAll(){dashTables.innerHTML=state.tables.slice(0,8).map(tableHTML).join('');allTables.innerHTML=state.tables.map(tableHTML).join('');occupiedCount.textContent=`${state.tables.filter(t=>t.status!=='free').length} / ${state.tables.length}`;activeOrders.textContent=state.orders.filter(o=>o.status!=='paid'&&o.status!=='closed').length;toPay.textContent=state.orders.filter(o=>['ready','pay'].includes(o.status)).length;sales.textContent=`€${state.sales.toFixed(2)}`;activity.innerHTML=state.activity.slice(-5).reverse().map(x=>`<div class="row"><div><b>${x}</b><small>Actividad demo</small></div></div>`).join('');renderKDS();renderCash();renderOrders();if(document.getElementById('order').classList.contains('active'))renderCart()}
function productsEl(){let q=(document.getElementById('productSearch')?.value||'').toLowerCase(),cat=document.getElementById('categoryFilter')?.value||'all';let list=products.filter(p=>(cat==='all'||p.cat===cat)&&p.n.toLowerCase().includes(q));let html=list.map(p=>`<button class="product" onclick="addProduct(${p.id})"><strong>${p.n}</strong><small>${p.cat} · ${p.d==='bar'?'🍸 Bar':'🍳 Cocina'}</small><em>€${p.p.toFixed(2)}</em></button>`).join('');document.getElementById('products').innerHTML=html;adminProducts.innerHTML=products.map(p=>`<div class="product"><strong>${p.n}</strong><small>${p.cat} · ${p.d}</small><em>€${p.p.toFixed(2)}</em></div>`).join('')}
function setOrderMode(mode){orderMode=mode;modeTable.classList.toggle('active',mode==='table');modeQuick.classList.toggle('active',mode==='quick');quickInfo.style.display=mode==='quick'?'block':'none';quickPayBtn.style.display=mode==='quick'?'block':'none';if(mode==='quick'){currentTable=null;currentOrderId=null;cart=[];cartTable.textContent='Nueva orden';orderHeading.textContent='Servicio rápido · Prepago';cartTitle.textContent='Nueva orden'}else{cartTitle.textContent='Cuenta abierta';if(!currentTable){let f=state.tables.find(t=>t.status==='free');if(f)openTable(f.id)}}renderCart()}
function openTable(id){orderMode='table';modeTable?.classList.add('active');modeQuick?.classList.remove('active');quickInfo.style.display='none';quickPayBtn.style.display='none';currentTable=id;let o=openOrderForTable(id);currentOrderId=o?.id||null;cart=[];cartTable.textContent='Mesa '+id;orderHeading.textContent=(o?'Continuar cuenta':'Abrir cuenta')+' · Mesa '+id;cartTitle.textContent='Cuenta abierta';renderCart();go('order')}
function newOrder(){setOrderMode('table');let free=state.tables.find(t=>t.status==='free');openTable(free?.id||1)}
function addProduct(id){if(orderMode==='table'&&!currentTable){newOrder();return}let p=products.find(x=>x.id===id),line=cart.find(x=>x.id===id&&!x.note);line?line.q++:cart.push({...p,q:1,note:''});renderCart()}
function changeQty(i,d){cart[i].q+=d;if(cart[i].q<=0)cart.splice(i,1);renderCart()}
function removeDraft(i){cart.splice(i,1);renderCart()}
function editNote(i){noteIndex=i;noteText.value=cart[i].note||'';noteModal.classList.add('open')}
function closeNote(){noteModal.classList.remove('open')}
function saveNote(){if(noteIndex!==null)cart[noteIndex].note=noteText.value.trim();closeNote();renderCart()}
function currentOrder(){return state.orders.find(o=>o.id===currentOrderId)}
function renderCart(){let o=currentOrder();let rounds=o?.rounds||[];sentRounds.innerHTML=rounds.map((r,ri)=>`<div class="sent-block"><div class="sent-head"><span>COMANDA ${ri+1} · ${new Date(r.created).toLocaleTimeString([],{hour:'2-digit',minute:'2-digit'})}</span><span>${(r.status||'sent').toUpperCase()}</span></div>${r.items.map(i=>`<div style="display:flex;justify-content:space-between;gap:10px;margin:7px 0;${i.voided?'opacity:.45;text-decoration:line-through':''}"><div><b>${i.q} × ${i.n}</b>${i.note?`<small style="display:block;color:var(--muted)">↳ ${i.note}</small>`:''}<span class="station">${i.d==='bar'?'BAR':'COCINA'} · bloqueado</span></div><div><strong>€${(i.p*i.q).toFixed(2)}</strong>${!i.voided?`<button class="mini danger" style="display:block;margin-top:5px" onclick="voidSent(${r.id},${i.lineId})">Anular</button>`:''}</div></div>`).join('')}</div>`).join('');cart.innerHTML=cart.length?`<div class="sent-head"><span>NUEVOS · SIN ENVIAR</span><span>EDITABLE</span></div>`+cart.map((x,i)=>`<div class="draft-line"><div><b>${x.n}</b><small style="display:block;color:var(--muted)">${x.d==='bar'?'🍸 Bar':'🍳 Cocina'}${x.note?' · '+x.note:''}</small><div class="line-actions"><button class="mini" onclick="editNote(${i})">✎ Nota</button><button class="mini danger" onclick="removeDraft(${i})">× Quitar</button></div></div><div><div class="qty"><button onclick="changeQty(${i},-1)">−</button><b>${x.q}</b><button onclick="changeQty(${i},1)">+</button></div><strong style="display:block;text-align:right;margin-top:8px">€${(x.p*x.q).toFixed(2)}</strong></div></div>`).join(''):'<div style="color:var(--muted);padding:16px 0;text-align:center">No hay productos nuevos por enviar</div>';let total=(o?orderTotal(o):0)+cart.reduce((s,x)=>s+x.p*x.q,0);cartTotal.textContent='€'+total.toFixed(2);sendBtn.disabled=!cart.length;sendBtn.style.opacity=cart.length?'1':'.45'}
function ensureOrder(){let o=currentOrder();if(o)return o;o={id:state.nextOrder++,mode:orderMode,table:orderMode==='table'?currentTable:null,pager:orderMode==='quick'?(pagerNo.value.trim()||null):null,rounds:[],status:'open',created:Date.now(),paid:false};state.orders.push(o);currentOrderId=o.id;if(o.table){state.tables.find(t=>t.id===o.table).status='occupied'}return o}
function sendOrder(){if(!cart.length)return alert('Añade productos nuevos antes de enviar.');if(orderMode==='table'&&!currentTable)return alert('Selecciona una mesa.');let o=ensureOrder(),round={id:o.rounds.length+1,created:Date.now(),status:'new',items:cart.map((x,j)=>({...x,lineId:Date.now()+j,voided:false}))};o.rounds.push(round);o.status=o.paid?'preparing':'open';state.activity.push(`Comanda ${round.id} · Orden #${o.id}${o.table?' · Mesa '+o.table:''}`);cart=[];save();renderCart();if(orderMode==='quick')go('kitchen')}
function quickPayAndSend(){if(orderMode!=='quick')return;if(!cart.length)return alert('Añade productos.');let o=ensureOrder();o.paid=true;o.payment='Tarjeta / efectivo (demo)';sendOrder();o=state.orders.find(x=>x.id===currentOrderId);o.status='preparing';state.sales+=orderTotal(o);state.activity.push(`Orden #${o.id} cobrada · Prepago`);save();go('kitchen')}
function voidSent(roundId,lineId){let o=currentOrder();if(!o)return;if(!confirm('Este producto ya fue enviado. Se registrará como ANULADO, no se eliminará del historial.'))return;let r=o.rounds.find(x=>x.id===roundId),i=r.items.find(x=>x.lineId===lineId);i.voided=true;state.activity.push(`Producto anulado · Orden #${o.id} · ${i.n}`);save()}
function transferTable(){if(orderMode!=='table'||!currentTable)return alert('Esta acción aplica a servicio de mesa.');let dest=prompt('Mover la cuenta a la mesa número:');dest=Number(dest);if(!dest||dest===currentTable||!state.tables.find(t=>t.id===dest))return;let o=currentOrder();if(o&&openOrderForTable(dest))return alert('La mesa destino ya tiene una cuenta abierta. Usa “Unir mesas”.');state.tables.find(t=>t.id===currentTable).status='free';state.tables.find(t=>t.id===dest).status=o?'occupied':'free';if(o)o.table=dest;currentTable=dest;cartTable.textContent='Mesa '+dest;state.activity.push(`Cuenta movida a Mesa ${dest}`);save();renderCart()}
function renderKDS(){let jobs=[];state.orders.forEach(o=>(o.rounds||[]).forEach(r=>{if(['new','preparing'].includes(r.status)&&r.items.some(i=>!i.voided))jobs.push({o,r})}));kds.innerHTML=jobs.length?jobs.map(({o,r})=>`<div class="card ticket"><div class="section-title"><h3>${o.table?'Mesa '+o.table:'Orden #'+o.id}</h3><span class="badge">#${o.id} · C${r.id}</span></div><div class="time">${r.status==='new'?'NUEVO':'PREPARANDO'}</div>${o.pager?`<div class="badge">Pager ${o.pager}</div>`:''}${r.items.filter(i=>!i.voided).map(i=>`<div style="margin:8px 0">${i.q} × <b>${i.n}</b> <small>· ${i.d==='bar'?'BAR':'COCINA'}</small>${i.note?`<small style="display:block">↳ ${i.note}</small>`:''}</div>`).join('')}<button class="btn ${r.status==='preparing'?'primary':''}" onclick="advanceRound(${o.id},${r.id})">${r.status==='new'?'Empezar preparación':'✓ Marcar comanda lista'}</button></div>`).join(''):'<div class="card placeholder"><div><div class="icon">✓</div><h3>Sin comandas pendientes</h3><p>Los nuevos envíos aparecerán aquí como rondas independientes.</p></div></div>'}
function advanceRound(oid,rid){let o=state.orders.find(x=>x.id===oid),r=o.rounds.find(x=>x.id===rid);if(r.status==='new')r.status='preparing';else{r.status='ready';let all=o.rounds.every(x=>x.status==='ready'||x.status==='delivered');if(all){o.status=o.paid?'ready':'pay';if(o.table)state.tables.find(t=>t.id===o.table).status=o.paid?'ready':'pay'}state.activity.push(`Comanda ${rid} lista · Orden #${oid}`)}save()}
function renderCash(){let arr=state.orders.filter(o=>o.mode==='table'&&o.status!=='paid'&&o.status!=='closed'&&(o.rounds||[]).length);cashList.innerHTML=arr.length?arr.map(o=>`<div class="row"><div><b>Mesa ${o.table} · Orden #${o.id}</b><small>${o.rounds.length} comandas · cuenta abierta</small></div><div><strong>€${orderTotal(o).toFixed(2)}</strong> <button class="btn primary" onclick="pay(${o.id})">Cobrar y cerrar</button></div></div>`).join(''):'<div style="padding:30px;text-align:center;color:var(--muted)">No hay cuentas abiertas.</div>'}
function pay(id){let o=state.orders.find(x=>x.id===id);if(o.paid)return;o.paid=true;o.status='paid';state.sales+=orderTotal(o);if(o.table)state.tables.find(t=>t.id===o.table).status='free';state.activity.push(`${o.table?'Mesa '+o.table:'Orden #'+o.id} cobrada · €${orderTotal(o).toFixed(2)}`);save()}
function renderOrders(){ordersList.innerHTML=state.orders.slice().reverse().map(o=>`<div class="row"><div><b>#${o.id} · ${o.table?'Mesa '+o.table:'Servicio rápido'}${o.pager?' · Pager '+o.pager:''}</b><small>${(o.rounds||[]).length} comandas · ${(o.rounds||[]).flatMap(r=>r.items).filter(i=>!i.voided).map(i=>i.q+'× '+i.n).join(', ')}</small></div><div><span class="badge">${(o.status||'OPEN').toUpperCase()}</span> <strong>€${orderTotal(o).toFixed(2)}</strong></div></div>`).join('')||'<div style="padding:30px;text-align:center;color:var(--muted)">Todavía no hay pedidos.</div>'}
function resetDemo(){if(confirm('¿Restablecer todos los datos de demostración?')){localStorage.removeItem('restos-demo');location.reload()}}init();
</script></body></html>
