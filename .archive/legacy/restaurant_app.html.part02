complete="new-password" placeholder="Mínimo 8 caracteres"></div><div class="field"><label>Confirmar contraseña</label><input id="regPass2" type="password" autocomplete="new-password" placeholder="Repite la contraseña"></div><div class="auth-error" id="regError"></div><button class="auth-btn" id="registerBtn" onclick="startRegistration()">Crear cuenta y enviar código</button><button class="auth-btn secondary" onclick="showAuth('loginView')">Volver al ingreso</button></div>
    <div class="auth-view" id="verifyView"><h1>Verifica tu correo</h1><p class="sub">Enviamos un código de 6 dígitos a <b id="verifyEmail"></b>. Para RestOS+ lo tratamos como válido durante 3 minutos.</p><div class="code-boxes" id="codeBoxes"></div><div class="timer" id="verifyTimer">03:00</div><div class="auth-error" id="verifyError"></div><button class="auth-btn" id="verifyBtn" onclick="verifyCode()">Verificar correo</button><button class="auth-btn secondary" onclick="resendCode()">Reenviar código</button><div class="devbox" id="demoCode"><b>Correo real:</b> el código lo genera Supabase. La plantilla “Confirm signup” debe incluir <code>{{ .Token }}</code> para mostrarlo como PIN de 6 dígitos.</div></div>
    <div class="auth-view pending-card" id="pendingView"><div class="pending-icon" id="pendingIcon">✓</div><h1 id="pendingTitle">Registro completado</h1><p id="pendingMessage">Tu correo quedó verificado y la solicitud fue registrada. <b>Esto todavía no concede acceso al sistema.</b> Un administrador deberá asignarte un rol y aprobar tu cuenta.</p><button class="auth-btn" onclick="showAuth('loginView')">Volver al ingreso</button></div>
    <div class="auth-view" id="forgotView"><h1>Recuperar contraseña</h1><p class="sub">Introduce el correo asociado a tu cuenta. Enviaremos un código de recuperación.</p><div class="field"><label>Correo electrónico</label><input id="forgotEmail" type="email" autocomplete="email" placeholder="nombre@correo.com"></div><div class="auth-error" id="forgotError"></div><button class="auth-btn" id="recoverySendBtn" onclick="startRecovery()">Enviar código</button><button class="auth-btn secondary" onclick="showAuth('loginView')">Volver</button></div>
    <div class="auth-view" id="recoveryCodeView"><h1>Comprueba tu correo</h1><p class="sub">Escribe el código de 6 dígitos enviado a <b id="recoveryEmailLabel"></b>.</p><div class="field"><label>Código</label><input id="recoveryCode" inputmode="numeric" maxlength="6" autocomplete="one-time-code" placeholder="000000"></div><div class="timer" id="recoveryTimer">03:00</div><div class="auth-error" id="recoveryError"></div><button class="auth-btn" id="recoveryVerifyBtn" onclick="checkRecoveryCode()">Continuar</button><button class="auth-btn secondary" onclick="resendRecoveryCode()">Reenviar código</button></div>
    <div class="auth-view" id="newPasswordView"><h1>Nueva contraseña</h1><p class="sub">Crea una nueva contraseña para tu cuenta.</p><div class="field"><label>Nueva contraseña</label><input id="newPass1" type="password" autocomplete="new-password" placeholder="Mínimo 8 caracteres"></div><div class="field"><label>Confirmar contraseña</label><input id="newPass2" type="password" autocomplete="new-password" placeholder="Repite la contraseña"></div><div class="auth-error" id="newPassError"></div><button class="auth-btn" id="newPasswordBtn" onclick="finishRecovery()">Actualizar contraseña</button></div>
  </div>
</div></div>
<div class="app"><aside class="side"><div class="brand">RestOS+<small>RESTAURANT SYSTEM</small></div><nav class="nav" id="nav"></nav><div class="profile"><b id="profileName">Administrador</b><span id="profileRole">Acceso de desarrollo · acceso total</span><button class="logout" onclick="logout()">Cerrar sesión</button></div></aside><main class="main"><header class="top"><h1 id="pageTitle">Dashboard</h1><div class="actions"><button class="btn" id="topKitchenBtn" onclick="go('kitchen')">🍳 Cocina</button><button class="btn primary" id="topNewOrderBtn" onclick="newOrder()">＋ Nuevo pedido</button></div></header><div class="content">
<section id="dashboard" class="view active"><div class="hero"><div><h2>Buenos días 👋</h2><p>Vista general de la operación del restaurante.</p></div><button class="btn" onclick="resetDemo()">Restablecer demo</button></div><div class="grid stats"><div class="card stat"><span class="label">Mesas ocupadas</span><strong id="occupiedCount">0 / 12</strong><small>Estado en tiempo real</small></div><div class="card stat"><span class="label">Pedidos activos</span><strong id="activeOrders">0</strong><small>Cocina y salón</small></div><div class="card stat"><span class="label">Por cobrar</span><strong id="toPay">0</strong><small>Cuentas pendientes</small></div><div class="card stat"><span class="label">Ventas del día</span><strong id="sales">€0.00</strong><small>Pedidos cerrados</small></div></div><div class="grid two" style="margin-top:16px"><div class="card"><div class="section-title"><h3>Estado del salón</h3><button class="btn" onclick="go('tables')">Ver mesas</button></div><div class="tables" id="dashTables"></div></div><div class="card"><div class="section-title"><h3>Acciones rápidas</h3></div><div class="quick"><button onclick="newOrder()"><span class="bigico">🧾</span>Tomar pedido</button><button onclick="go('cashier')"><span class="bigico">💳</span>Cobrar mesa</button><button onclick="go('kitchen')"><span class="bigico">🍳</span>Cocina</button><button onclick="go('inventory')"><span class="bigico">📦</span>Inventario</button></div><div class="section-title" style="margin-top:22px"><h3>Actividad</h3></div><div class="list" id="activity"></div></div></div></section>
<section id="tables" class="view"><div class="hero"><div><h2>Mesas y salón</h2><p>Toca una mesa para abrir o continuar su pedido.</p></div></div><div class="card"><div class="tables" id="allTables"></div></div></section>
<section id="order" class="view"><div class="hero"><div><h2 id="orderHeading">Toma de pedido</h2><p>Cuenta abierta por mesa o servicio rápido prepago. Cada envío crea una comanda independiente.</p></div></div><div class="order-mode"><button id="modeTable" class="seg active" onclick="setOrderMode('table')">🍽️ Servicio de mesa</button><button id="modeQuick" class="seg" onclick="setOrderMode('quick')">⚡ Servicio rápido / Prepago</button></div><div class="order-tools"><select id="categoryFilter" onchange="productsEl()"><option value="all">Todas las categorías</option><option>Comida</option><option>Bebidas</option><option>Postres</option></select><input id="productSearch" placeholder="Buscar producto…" oninput="productsEl()"><button class="btn" onclick="transferTable()">⇄ Cambiar mesa</button><button class="btn" onclick="alert('Prototipo: aquí abriremos Dividir cuenta / mover productos.')">✂ Dividir cuenta</button><button class="btn" onclick="alert('Prototipo: aquí podremos unir dos mesas abiertas.')">⊕ Unir mesas</button></div><div class="order-layout"><div class="card"><div class="section-title"><h3>Menú</h3><span class="badge">Toca para agregar</span></div><div class="products" id="products"></div></div><div class="card order-cart"><div class="section-title"><h3 id="cartTitle">Cuenta abierta</h3><span id="cartTable" class="badge">Mesa —</span></div><div id="quickInfo" class="quickpay" style="display:none"><b>Servicio rápido</b><div style="margin-top:7px"><input id="pagerNo" placeholder="Pager / turno (opcional)" style="width:100%;height:42px;border:1px solid var(--line);border-radius:10px;padding:0 10px"></div></div><div id="sentRounds"></div><div id="cart"></div><div class="order-summary"><div class="row" style="padding:8px 0;border:0"><b>Total cuenta</b><strong id="cartTotal">€0.00</strong></div></div><button id="sendBtn" class="btn primary" style="width:100%;margin-top:12px;min-height:54px" onclick="sendOrder()">Enviar nuevos productos</button><button id="quickPayBtn" class="btn" style="width:100%;margin-top:9px;min-height:50px;display:none" onclick="quickPayAndSend()">💳 Cobrar y enviar</button></div></div></section>
<section id="kitchen" class="view"><div class="hero"><div><h2>Kitchen Display</h2><p>Comandas activas. Cocina cambia el estado y el salón se actualiza.</p></div></div><div class="kds" id="kds"></div></section>
<section id="cashier" class="view"><div class="hero"><div><h2>Caja · Cobrar mesa</h2><p>Selecciona una cuenta pendiente para registrar el pago.</p></div></div><div class="card"><div class="list" id="cashList"></div></div></section>
<section id="orders" class="view"><div class="hero"><div><h2>Pedidos</h2><p>Historial y estado operativo.</p></div></div><div class="card"><div class="list" id="ordersList"></div></div></section>
<section id="inventory" class="view"><div class="hero"><div><h2>Inventario</h2><p>Stock, mínimos, movimientos y recetas. El backend se conectará después.</p></div><button class="btn primary">＋ Entrada de stock</button></div><div class="grid stats"><div class="card stat"><span class="label">Productos</span><strong>148</strong><small>Ingredientes y consumibles</small></div><div class="card stat"><span class="label">Stock bajo</span><strong>7</strong><small>Requieren atención</small></div><div class="card stat"><span class="label">Proveedores</span><strong>12</strong><small>Activos</small></div><div class="card stat"><span class="label">Valor estimado</span><strong>€8,420</strong><small>Inventario actual</small></div></div></section>
<section id="customers" class="view"><div class="hero"><div><h2>Clientes</h2><p>Registro, historial, preferencias y fidelización.</p></div><button class="btn primary">＋ Registrar cliente</button></div><div class="card placeholder"><div><div class="icon">👥</div><h3>Base de clientes</h3><p>Esta vista quedará restringida por permisos. Aquí conectaremos búsquedas, historial de visitas, gasto acumulado y consentimiento de datos.</p></div></div></section>
<section id="reservations" class="view"><div class="hero"><div><h2>Reservas</h2><p>Agenda, número de personas, mesa y estado de confirmación.</p></div><button class="btn primary">＋ Nueva reserva</button></div><div class="card placeholder"><div><div class="icon">📅</div><h3>Agenda de reservas</h3><p>Se conectará directamente con el plano de mesas para bloquear disponibilidad y registrar no-shows.</p></div></div></section>
<section id="productsView" class="view"><div class="hero"><div><h2>Productos y menú</h2><p>Precios, categorías, preparación, variantes y recetas.</p></div><button class="btn primary">＋ Producto</button></div><div class="card"><div class="products" id="adminProducts"></div></div></section>
<section id="staff" class="view"><div class="hero"><div><h2>Personal y permisos</h2><p>Registro, aprobación, roles y permisos por usuario.</p></div><button class="btn primary" onclick="alert('Siguiente etapa: invitar usuario o aprobar solicitudes pendientes.')">＋ Usuario</button></div><div class="grid two"><div class="card"><div class="section-title"><h3>Roles base de RestOS+</h3><span class="badge">7 presets</span></div><div class="list"><div class="row"><div><b>Owner / Super Admin</b><small>Control total del restaurante.</small></div><span>👑</span></div><div class="row"><div><b>Manager / Supervisor</b><small>Operación diaria, caja, incidencias y reportes.</small></div><span>🧭</span></div><div class="row"><div><b>Waiter / Mesero</b><small>Mesas, pedidos y servicio.</small></div><span>🧾</span></div><div class="row"><div><b>Cashier / Caja</b><small>Cobros y cierre de cuentas.</small></div><span>💳</span></div><div class="row"><div><b>Kitchen / Cocina</b><small>KDS y estados de preparación.</small></div><span>🍳</span></div><div class="row"><div><b>Bar</b><small>Comandas asignadas a barra.</small></div><span>🍸</span></div><div class="row"><div><b>Inventory / Store</b><small>Stock, movimientos y compras.</small></div><span>📦</span></div></div></div><div class="card"><div class="section-title"><h3>Flujo de alta</h3><span class="badge">Seguro</span></div><div class="list"><div class="row"><b>1. Registro</b><span>Correo + contraseña / Google</span></div><div class="row"><b>2. Verificación</b><span>Código por correo</span></div><div class="row"><b>3. Estado</b><span class="badge">PENDIENTE</span></div><div class="row"><b>4. Administrador</b><span>Aprueba + asigna rol</span></div><div class="row"><b>5. Acceso</b><span class="badge">ACTIVO</span></div></div><div class="notice warn" style="margin-top:16px">Verificar el correo o entrar con Google identifica a la persona, pero <b>no concede permisos</b>. El acceso depende de una membresía activa y de su rol.</div></div></div></section>
<section id="reports" class="view"><div class="hero"><div><h2>Reportes</h2><p>Ventas, ticket promedio, productos, métodos de pago y rendimiento.</p></div></div><div class="grid stats"><div class="card stat"><span class="label">Ticket promedio</span><strong>€31.40</strong><small>Demo</small></div><div class="card stat"><span class="label">Top producto</span><strong>Burger</strong><small>24 unidades</small></div><div class="card stat"><span class="label">Efectivo</span><strong>38%</strong><small>De pagos</small></div><div class="card stat"><span class="label">Tarjeta</span><strong>62%</strong><small>De pagos</small></div></div></section>
<section id="tv" class="view"><div class="tv"><div><div style="font-size:70px">🍽️</div><h2>Bienvenidos a Nuestro Restaurante</h2><p style="color:#c4d5ce;font-size:20px">Síguenos y descubre nuestras novedades</p><div class="socials"><div><strong>12.8K</strong><span>Instagram followers</span></div><div><strong>8.4K</strong><span>Facebook followers</span></div><div><strong>4.9★</strong><span>Valoración</span></div></div><p style="margin-top:45px">▣ Escanea nuestro QR · @restaurante</p></div></div></section>
<section id="settings" class="view"><div class="hero"><div><h2>Configuración</h2><p>Restaurante, impuestos, mesas, pagos, impresión y comportamiento del sistema.</p></div><